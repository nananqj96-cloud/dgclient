{
	"schemaVersion": 1,
	"id": "dgclient",
	"version": "${version}",
	"name": "DGClient",
	"description": "Standalone neon-green & white anarchy utility mod for Minecraft 1.21.11 featuring ClickGUI, HUD Editor, ESP/Tracers, Y-0 Diagnostics & Underground Bypass, and async BaseFinder.",
	"authors": [
		"DGClient Team"
	],
	"contact": {
		"homepage": "https://github.com/nananqj96-cloud/dgclient",
		"sources": "https://github.com/nananqj96-cloud/dgclient",
		"issues": "https://github.com/nananqj96-cloud/dgclient/issues"
	},
	"license": "MIT",
	"icon": "assets/dgclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.dg.client.DGClient"
		]
	},
	"mixins": [
		{
			"config": "dgclient.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": ">=1.21.11 <1.22.0",
		"java": ">=21",
		"fabric-api": ">=0.141.0"
	}
}
