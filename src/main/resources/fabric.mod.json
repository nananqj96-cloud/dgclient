{
  "schemaVersion": 1,
  "id": "aetherclient",
  "version": "${version}",
  "name": "Aether Client",
  "description": "High-performance Minecraft 1.21.11 utility client featuring the PinkBloom aesthetic, zero-lag dual-mode NanoVG interface, synced Corz Port secondary UI, customizable HUD, and modular tools.",
  "authors": ["Aether Team"],
  "license": "MIT",
  "icon": "assets/aetherclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.aether.AetherClient"]
  },
  "mixins": ["aetherclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "jars": [
    {"file": "META-INF/jars/lwjgl-nanovg-3.3.3-natives-linux-arm64.jar"},
    {"file": "META-INF/jars/lwjgl-nanovg-3.3.3-natives-linux.jar"},
    {"file": "META-INF/jars/lwjgl-nanovg-3.3.3-natives-macos-arm64.jar"},
    {"file": "META-INF/jars/lwjgl-nanovg-3.3.3-natives-macos.jar"},
    {"file": "META-INF/jars/lwjgl-nanovg-3.3.3-natives-windows-arm64.jar"},
    {"file": "META-INF/jars/lwjgl-nanovg-3.3.3-natives-windows.jar"},
    {"file": "META-INF/jars/lwjgl-nanovg-3.3.3.jar"}
  ]
}
